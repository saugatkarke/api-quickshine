NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://quickshine:quickshine@localhost:5432/quickshine
FRONTEND_URL=http://localhost:3000

# SMTP is required for admin email notifications.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM="Quick Shine <no-reply@quickshine.com.au>"
ADMIN_EMAIL=admin@quickshine.com.au

# Outlook calendar integration. Requires Microsoft Graph application permission
# Calendars.ReadWrite and admin consent for the tenant.
OUTLOOK_TENANT_ID=your-azure-tenant-id
OUTLOOK_CLIENT_ID=your-azure-application-client-id
OUTLOOK_CLIENT_SECRET=your-azure-client-secret-value
OUTLOOK_CALENDAR_USER=admin@quickshine.com.au
OUTLOOK_CALENDAR_TIME_ZONE=Australia/Sydney

# Stripe payments. The backend charges this fixed advance amount.
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_CURRENCY=aud
STRIPE_ADVANCE_AMOUNT=90

